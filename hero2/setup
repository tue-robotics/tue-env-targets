#! /usr/bin/env bash

alias hero2-test-rgbd-shm="rosrun rgbd rgbd_test_client_shm --headless test:=/hero/head_rgbd_sensor/rgbd"

if [[ "${TUE_ENV_ROS_USE_IP}" == "true" ]]
then
    unset ROS_HOSTNAME
    export ROS_IP=192.168.44.52
    export ROS_MASTER_URI=http://192.168.44.51:11311
fi

# CUDA is installed via the cuda-12-3 apt package, which doesn't put nvcc on the PATH.
# Without it, CMake's enable_language(CUDA) can't find the compiler.
if [[ -d /usr/local/cuda/bin && :$PATH: != *:/usr/local/cuda/bin:* ]]
then
    export PATH=/usr/local/cuda/bin${PATH:+:${PATH}}
fi

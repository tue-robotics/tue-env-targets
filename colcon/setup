#! /usr/bin/env bash

# Enable tab completion
# shellcheck disable=SC1091
source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash

# The ROS apt repo installs colcon_cd in /usr/share/colcon_cd, the Ubuntu package (>= 26.04) in /etc/profile.d
for candidate in /usr/share/colcon_cd/function/colcon_cd-argcomplete.bash /etc/profile.d/colcon_cd-argcomplete.bash
do
    if [[ -f "${candidate}" ]]
    then
        # shellcheck disable=SC1090
        source "${candidate}"
        break
    fi
done
unset candidate

# Run colcon with the venv interpreter, see bin/colcon
colcon_bin_dir="${TUE_ENV_TARGETS_DIR}/colcon/bin"
if [[ :$PATH: != *:${colcon_bin_dir}:* ]]
then
    export PATH=${colcon_bin_dir}${PATH:+:${PATH}}
fi
unset colcon_bin_dir
